# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# ── Google Gemini ────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza...
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_DEFAULT_MODEL=gemini-1.5-pro

# ── Crusoe Cloud ─────────────────────────────────────────────────────────────
CRUSOE_API_KEY=...
CRUSOE_BASE_URL=https://api.crusoe.ai/v1
CRUSOE_DEFAULT_MODEL=llama-3-70b-instruct

# ── Ollama (local) ───────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3

# ── Gateway behaviour ────────────────────────────────────────────────────────
# Comma-separated ordered list of providers to try on each request
PROVIDER_PRIORITY=openai,anthropic,gemini,crusoe,ollama

# Circuit-breaker thresholds
CB_FAILURE_THRESHOLD=5       # consecutive failures before opening
CB_RECOVERY_TIMEOUT=60       # seconds to wait before moving to half-open
CB_SUCCESS_THRESHOLD=2       # successes in half-open state to close again

# Retry settings
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_WAIT=1.0       # seconds (exponential back-off base)
RETRY_MAX_WAIT=10.0          # seconds

# Request timeout
REQUEST_TIMEOUT=30.0         # seconds

# Application
APP_ENV=development
LOG_LEVEL=INFO
